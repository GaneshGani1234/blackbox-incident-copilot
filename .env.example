# ---------- Hindsight (memory) ----------
# Cloud: base URL is https://api.hindsight.vectorize.io ; create a key on the Connect / API Keys page of ui.hindsight.vectorize.io
# Self-hosted (Docker): http://localhost:8888  (API key not required)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=paste-your-hindsight-key-here
HINDSIGHT_BANK_ID=checkout-team

# "hindsight" = real Hindsight memory (use this for the demo and the submission)
# "local"     = tiny in-process fallback so you can develop offline. Never demo with this.
MEMORY_BACKEND=hindsight

# ---------- LLM (Groq, OpenAI-compatible) ----------
GROQ_API_KEY=paste-your-groq-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=qwen/qwen3-32b
# "groq" = call the LLM, "mock" = deterministic offline answer built from recalled memories (for tests)
LLM_MODE=groq

# Set to false on the public demo so visitors cannot wipe the memory bank
ALLOW_RESET=true
